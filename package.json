{
  "name": "vocab-bloom-hub",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "description": "A self-hosted English dictionary: 300 000 entries with meanings, examples, forms, translations and word links behind a public API, an admin UI, two SDKs, a website and an open dataset.",
  "homepage": "https://vocab-bloom-hub.com",
  "author": {
    "name": "Aleksei Ryzhov (Fristail27)",
    "url": "https://github.com/Fristail27"
  },
  "bugs": {
    "url": "https://github.com/Fristail27/vocab-bloom-hub/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fristail27/vocab-bloom-hub.git"
  },
  "keywords": [
    "dictionary",
    "english",
    "vocabulary",
    "lexicon",
    "translation",
    "synonyms",
    "definitions",
    "dictionary-api",
    "dataset",
    "self-hosted",
    "open-source",
    "nestjs",
    "nextjs",
    "typescript",
    "sdk",
    "vocab-bloom-hub"
  ],
  "license": "MIT",
  "type": "module",
  "scripts": {
    "front:dev": "yarn workspace frontend dev",
    "site:dev": "yarn workspace site dev",
    "site:build": "yarn workspace site build",
    "server:dev": "yarn workspace server start:dev",
    "dev": "concurrently --names server,frontend,site \"yarn server:dev\" \"yarn front:dev\" \"yarn site:dev\"",
    "build": "yarn workspace server build && yarn workspace frontend build",
    "start:server": "yarn workspace server start:prod",
    "start:front": "yarn workspace frontend start",
    "start:site": "yarn workspace site start",
    "start": "concurrently --kill-others --names server,frontend \"yarn start:server\" \"yarn start:front\"",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "e2e:build": "NODE_ENV=production NEXT_PUBLIC_BASE_API_URL=http://localhost:3011/api yarn workspace frontend build",
    "e2e": "yarn e2e:build && yarn workspace e2e test",
    "e2e:ui": "yarn e2e:build && yarn workspace e2e test:ui",
    "e2e:site:build": "NODE_ENV=production NEXT_PUBLIC_BASE_API_URL=/api NEXT_PUBLIC_SITE_URL=http://localhost:3021 yarn workspace site build",
    "e2e:site": "yarn e2e:site:build && yarn workspace e2e test:site",
    "e2e:site:ui": "yarn e2e:site:build && yarn workspace e2e test:site:ui",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "peers:check": "node scripts/check-peer-requirements.mjs",
    "check": "yarn lint && yarn format:check && yarn peers:check",
    "prepare": "husky",
    "jest": "NODE_OPTIONS=--experimental-vm-modules jest"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.3.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^26",
    "concurrently": "^10.0.5",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "jiti": "^2.7.0",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.8",
    "semver": "^7.8.5",
    "ts-jest": "^29.4.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1"
  },
  "engines": {
    "node": ">=22.13",
    "yarn": ">=4.15.0"
  },
  "resolutions": {
    "multer@npm:2.2.0": "2.3.0",
    "js-yaml@npm:4.3.1": "4.3.2"
  },
  "packageManager": "yarn@4.17.1",
  "dependencies": {
    "dotenv-cli": "^11.0.0"
  }
}
