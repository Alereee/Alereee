{
  "name": "server",
  "version": "1.0.0",
  "description": "API of Vocab Bloom Hub (NestJS + TypeORM): the public read-only dictionary API under /api/v1, the admin API, the dictionary import and the Postgres schema of a self-hosted instance.",
  "keywords": [
    "backend",
    "nestjs",
    "api",
    "dictionary-api",
    "nlp-api",
    "lexical-search",
    "semantic-network",
    "vocabulary-api",
    "language-processing",
    "multilingual",
    "etymology-api",
    "open-source",
    "microservices",
    "typescript",
    "vocab-bloom",
    "vocab-bloom-hub"
  ],
  "author": {
    "name": "Aleksei Ryzhov (Fristail27)",
    "url": "https://github.com/Fristail27"
  },
  "bugs": {
    "url": "https://github.com/Fristail27/vocab-bloom-hub/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fristail27/vocab-bloom-hub.git"
  },
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate -d src/db/data-source.ts",
    "migration:create": "typeorm-ts-node-commonjs migration:create",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d src/db/data-source.ts",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d src/db/data-source.ts",
    "migration:show": "typeorm-ts-node-commonjs migration:show -d src/db/data-source.ts",
    "openapi:generate": "ts-node -r tsconfig-paths/register src/openapi/generate.ts",
    "openapi:check": "ts-node -r tsconfig-paths/register src/openapi/generate.ts --check",
    "bench": "ts-node -r tsconfig-paths/register src/bench/run.ts",
    "db:reset": "typeorm-ts-node-commonjs schema:drop -d src/db/data-source.ts && typeorm-ts-node-commonjs migration:run -d src/db/data-source.ts",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:cov": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "test:debug": "node --experimental-vm-modules --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "NODE_OPTIONS=--experimental-vm-modules jest --config ./test/jest-e2e.json",
    "test:postgres": "NODE_OPTIONS=--experimental-vm-modules jest --config ./test/jest-postgres.json --runInBand",
    "fixture:public-api": "ts-node -r tsconfig-paths/register test/harness/public-api-fixture.ts"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.4",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.4",
    "@nestjs/platform-express": "^12.0.4",
    "@nestjs/swagger": "^12.0.1",
    "@nestjs/throttler": "^6.7.0",
    "@nestjs/typeorm": "^12.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "compression": "^1.8.2",
    "dotenv": "^18.0.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "nestjs-pino": "^5.2.0",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^1.1.0",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.3",
    "@nestjs/schematics": "^12.0.4",
    "@nestjs/testing": "^12.0.4",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^26",
    "@types/supertest": "^7.2.1",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "ajv": "^8.20.0",
    "better-sqlite3": "^13.0.3",
    "jest": "^30.5.2",
    "prettier": "^3.9.8",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.0",
    "ts-json-schema-generator": "^2.9.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3"
  }
}
