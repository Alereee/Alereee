# Copy to .env — one file for all apps. docs/environment.md lists the app variables;
# the compose-only knobs (POSTGRES_*, COMPOSE_PROFILES, VBH_TAG, PROMETHEUS_*,
# GRAFANA_*) are documented in docs/deployment/docker.md and docs/observability.md.
# The values below are what `docker compose up` needs; for a native start
# see docs/deployment/README.md.

# --- required -----------------------------------------------------------------
# The single admin account. The password is the root of the whole auth scheme
# (the JWT signing key is derived from it — docs/authentication.md), so make it
# a long random secret on any instance reachable by others.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# --- database -----------------------------------------------------------------
# docker compose ships a Postgres as the `db` profile: keep COMPOSE_PROFILES=db
# and the server uses it with the POSTGRES_* credentials below. The project
# website (docs, API reference, playground, word pages) is the `site` profile:
# COMPOSE_PROFILES=db,site starts it next to the instance (docs/deployment/docker.md).
# For a database of your own: remove the COMPOSE_PROFILES line and set
# DATABASE_URL to it (a database on the Docker host is host.docker.internal,
# not localhost). Native start: any postgres:// URL (production) or
# sqlite:<path> (development only).
COMPOSE_PROFILES=db
POSTGRES_USER=vocab
POSTGRES_PASSWORD=change-me-too
POSTGRES_DB=vocab_bloom
# DATABASE_URL=postgres://user:password@host.docker.internal:5432/vocab_bloom
# Postgres pool: max connections and idle timeout in seconds (defaults shown;
# keep replicas × DB_POOL_SIZE under a managed instance's connection limit)
# DB_POOL_SIZE=10
# DB_POOL_IDLE_TIMEOUT=10

# --- URLs ---------------------------------------------------------------------
# What the browser opens; the reverse proxy serves both apps under it and routes
# /api/* to the server. Set it to the public https origin in a real deployment.
# Relative (/api) means "the same origin as the page" and needs no rebuild.
NEXT_PUBLIC_BASE_API_URL=/api
CORS_ORIGINS=http://localhost:3241
# Hops of reverse proxy in front of the server (docs/deployment/reverse-proxy.md)
TRUST_PROXY=1

# --- ports (compose publishes them on localhost only) -------------------------
# The host ports of docker compose: 3240–3244, away from the 3000 / 9090 other
# tools take. A native start (yarn start, yarn dev) without these lines listens
# on 3010 (API), 3000 (admin UI) and 3020 (website).
SERVER_PORT=3240
FRONT_PORT=3241
# the website, when the `site` profile is on
# SITE_PORT=3242
# its public origin, for the canonical links, sitemap.xml and the social cards.
# Baked in at BUILD time: it takes effect with docker-compose.build.yml (or a
# native `yarn site:build`), never on a pulled image — the published one is the
# project's own website, https://vocab-bloom-hub.com (docs/deployment/docker.md)
# NEXT_PUBLIC_SITE_URL=https://vocabbloom.example
# the meta-tag tokens of the webmaster tools (Google Search Console, Bing, Yandex),
# baked in at BUILD time as well; DNS verification needs none of them
# SITE_VERIFICATION_GOOGLE=
# SITE_VERIFICATION_BING=
# SITE_VERIFICATION_YANDEX=

# --- images (docker compose) --------------------------------------------------
# Tag of the published images: a release such as `0.1.0-alpha.2` (recommended),
# `main` (development builds, the default), or `latest` (from the first stable release)
# VBH_TAG=1.0.0

# --- dictionary ---------------------------------------------------------------
# Load the published dictionary by itself on first start (empty instance):
# docker compose turns this on; for a native start set it here
# DICTIONARY_AUTO_IMPORT=true
# pin the first-start import to one dataset revision (a version tag of the HF repo)
# DICTIONARY_DATASET_VERSION=v0.2.0

# --- optional -----------------------------------------------------------------
NODE_ENV=production
# Days the journal of admin changes is kept (History page; 0 = forever)
# AUDIT_RETENTION_DAYS=90
# Seconds a graceful stop may take after SIGTERM (default 30)
# SHUTDOWN_TIMEOUT=30
# Log lines on stdout: json (the production default, for a log collector) or
# pretty (a terminal); minimum level verbose/debug/log/warn/error/fatal (docs/observability.md)
# LOG_FORMAT=json
# LOG_LEVEL=log
# Prometheus metrics (docs/observability.md); keep the endpoint private
# METRICS_ENABLED=true
# METRICS_PATH=/metrics
# Local Prometheus + Grafana (docker-compose.observability.yml overlay, which
# turns METRICS_ENABLED on by itself; docs/observability.md) — defaults shown
# PROMETHEUS_PORT=3243
# PROMETHEUS_RETENTION=15d
# GRAFANA_PORT=3244
# GRAFANA_ADMIN_USER=admin
# GRAFANA_ADMIN_PASSWORD=admin
# Datasets the import page may load from the server (compose mounts ./imports there)
# DICTIONARY_IMPORT_DIR=/data/dictionary-imports
# Which API surfaces to serve, the public rate limit and cache max-age (defaults shown)
# PUBLIC_API_ENABLED=true
# ADMIN_API_ENABLED=true
# PUBLIC_API_RATE_LIMIT=100/60
# A secret shared by the server and the website (the `site` profile): the site's own
# requests to the API — the word pages, the headword walk behind its sitemaps — carry it
# and are not counted against PUBLIC_API_RATE_LIMIT. 16+ characters; `openssl rand -hex 32`
# INTERNAL_API_TOKEN=
# PUBLIC_API_CACHE_MAX_AGE=3600
# The update notice of the admin UI: the server asks api.github.com for the latest
# stable release a few times a day, and the sources of the installed datasets for
# newer files once a day; false = no outgoing request (docs/upgrading.md, docs/datasets.md)
# UPDATE_CHECK=true
# Reports per client on the word pages' "Report a mistake" (docs/api.md)
# SUGGESTIONS_RATE_LIMIT=5/3600
