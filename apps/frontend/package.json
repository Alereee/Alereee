{
  "name": "frontend",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "description": "Admin UI of Vocab Bloom Hub (Next.js): the dictionary editor, search, imports, suggestions moderation and settings of a self-hosted instance.",
  "keywords": [
    "frontend",
    "nextjs",
    "react",
    "dictionary-ui",
    "vocabulary-ui",
    "nlp-ui",
    "language-learning",
    "linguistics",
    "semantic-search",
    "word-explorer",
    "multilingual-dictionary",
    "education",
    "open-source",
    "vocab-bloom",
    "vocab-bloom-hub"
  ],
  "author": {
    "name": "Aleksei Ryzhov (Fristail27)",
    "url": "https://github.com/Fristail27"
  },
  "bugs": {
    "url": "https://github.com/Fristail27/vocab-bloom-hub/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fristail27/vocab-bloom-hub.git"
  },
  "scripts": {
    "dev": "dotenv -e \"${ENV_FILE:-../../.env}\" -- next dev",
    "build": "NODE_ENV=production dotenv -e \"${ENV_FILE:-../../.env}\" -- next build",
    "start": "dotenv -e \"${ENV_FILE:-../../.env}\" -- next start"
  },
  "dependencies": {
    "@ant-design/cssinjs": "^2.1.2",
    "@ant-design/nextjs-registry": "^1.3.0",
    "antd": "^6.6.5",
    "js-cookie": "^3.0.7",
    "next": "16.3.5",
    "next-intl": "^4.14.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sass": "^1.104.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/js-cookie": "^3.0.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv-cli": "^11.0.0",
    "typescript": "^6.0.3"
  }
}
